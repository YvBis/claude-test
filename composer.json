{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-redis": "*",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^3.2",
        "lexik/jwt-authentication-bundle": "^2.20",
        "ramsey/uuid": "^4.7",
        "symfony/asset": "7.*",
        "symfony/clock": "7.*",
        "symfony/console": "^7.0",
        "symfony/dotenv": "^7.0",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "^7.0",
        "symfony/messenger": "^7.0",
        "symfony/property-access": "^7.0",
        "symfony/property-info": "^7.0",
        "symfony/redis-messenger": "^7.0",
        "symfony/runtime": "^7.0",
        "symfony/security-bundle": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/validator": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "friendsofphp/php-cs-fixer": "^3.55",
        "lcobucci/jwt": "*",
        "nelmio/api-doc-bundle": "^4.30",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpstan/phpstan-doctrine": "^1.3",
        "phpstan/phpstan-symfony": "^1.3",
        "phpunit/phpunit": "^9.0",
        "rector/rector": "1.2.10",
        "symfony/browser-kit": "7.*",
        "symfony/css-selector": "7.*",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/twig-bundle": "7.*",
        "twig/intl-extra": "^3.26",
        "twig/twig": "^3.28"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3",
            "ext-redis": "5.3"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Domain\\": "src/Domain/",
            "App\\Application\\": "src/Application/",
            "App\\Infrastructure\\": "src/Infrastructure/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "phpstan": "phpstan analyse src --memory-limit=512M",
        "phpcs:fix": "php-cs-fixer fix --ansi --allow-risky=yes",
        "phpcs:check": "php-cs-fixer fix --ansi --allow-risky=yes --dry-run --diff",
        "rector:dry-run": "rector process src --dry-run --ansi",
        "rector:fix": "rector process src --ansi",
        "phpunit": "phpunit --coverage-clover=var/coverage/clover.xml --coverage-html=var/coverage/html",
        "phpunit:no-coverage": "phpunit",
        "test": "@phpunit:no-coverage",
        "coverage:check": "XDEBUG_MODE=coverage phpunit --coverage-clover=var/coverage/clover.xml --coverage-html=var/coverage/html --coverage-php=var/coverage/coverage.php --log-junit=var/coverage/junit.xml",
        "openapi:generate": "php bin/console nelmio:apidoc:dump --format=json --no-pretty > public/api/openapi.json",
        "openapi:validate": "php bin/console lint:yaml public/api/openapi.json || true",
        "ci:static:quality": [
            "@phpstan",
            "@phpcs:check",
            "@rector:dry-run"
        ],
        "ci:test": "@phpunit:no-coverage",
        "ci:test:coverage": "phpunit --coverage-text",
        "ci:all": [
            "@ci:static:quality",
            "@ci:test"
        ],
        "ci:lint": "@phpcs:check"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.*"
        }
    }
}
