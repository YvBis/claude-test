APP_ENV=test
APP_SECRET=test-secret-key-ci
# Only DATABASE_URL is taken from this file by the local test bootstrap
# (tests/bootstrap.php:26-32); tests/bootstrap.php:14 never loads .env in the
# test environment, and the rest of the test env comes from phpunit.xml.dist
# (APP_ENV, KERNEL_CLASS, DEFAULT_URI, JWT_PASSPHRASE, MEILISEARCH_*). APP_SECRET
# is provided by neither layer and resolves lazily: the suite never touches
# kernel.secret (no session/secret/csrf usage in tests/, verified by grep), which
# is why CI stays green without it. MESSENGER_TRANSPORT_DSN is not here because
# nothing reads it in tests: messenger.yaml forces in-memory:// under when@test.
# MEILISEARCH_URL/MEILISEARCH_KEY are NOT here either — they moved to
# phpunit.xml.dist, which supplies them only when nothing else has. The Docker
# app container gets the compose service name from .env via env_file, while a
# host runner (CI, or PHPUnit with host PHP) needs 127.0.0.1:7700; a second copy
# of the address in this file would be a second source of truth for a value that
# is correct only for one of the two network namespaces.
DATABASE_URL=mysql://taskflow:taskflow_pass@db:3306/taskflow_test?serverVersion=8.0
DEFAULT_URI=http://localhost
KERNEL_CLASS='App\Kernel'

###> lexik/jwt-authentication-bundle ###
JWT_PASSPHRASE=test_passphrase
###< lexik/jwt-authentication-bundle ###