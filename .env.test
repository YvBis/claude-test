APP_ENV=test
APP_SECRET=test-secret-key-ci
# Only DATABASE_URL is taken from this file by the local test bootstrap
# (tests/bootstrap.php:26-32); tests/bootstrap.php:14 never loads .env in the
# test environment, and the rest of the test env comes from phpunit.xml.dist
# (APP_ENV, KERNEL_CLASS, DEFAULT_URI, JWT_PASSPHRASE). APP_SECRET is provided
# by neither layer and resolves lazily: the suite never touches kernel.secret
# (no session/secret/csrf usage in tests/, verified by grep), which is why CI
# stays green without it. MESSENGER_TRANSPORT_DSN and MEILISEARCH_KEY are not
# here because nothing reads them in tests: messenger.yaml forces in-memory://
# under when@test, and no Meilisearch bundle is installed.
DATABASE_URL=mysql://taskflow:taskflow_pass@db:3306/taskflow_test?serverVersion=8.0
MEILISEARCH_URL=http://127.0.0.1:7700
DEFAULT_URI=http://localhost
KERNEL_CLASS='App\Kernel'

###> lexik/jwt-authentication-bundle ###
JWT_PASSPHRASE=test_passphrase
###< lexik/jwt-authentication-bundle ###