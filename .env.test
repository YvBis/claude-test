APP_ENV=test
APP_SECRET=test-secret-key-ci
# Only DATABASE_URL is read by the local test bootstrap (tests/bootstrap.php); the other
# values are supplied by the container environment (env_file: .env) or by Symfony's Dotenv
# outside the test suite.
DATABASE_URL=mysql://taskflow:taskflow_pass@db:3306/taskflow_test?serverVersion=8.0
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey123
DEFAULT_URI=http://localhost
KERNEL_CLASS='App\Kernel'

###> lexik/jwt-authentication-bundle ###
JWT_PASSPHRASE=test_passphrase
