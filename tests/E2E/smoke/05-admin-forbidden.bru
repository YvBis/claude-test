meta {
  name: 05 Admin endpoint forbids a regular user
  type: http
  seq: 5
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/admin/users
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("admin endpoint returns 403 for a non-admin (authorization holds)", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
