meta {
  name: 05 List items in collection
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/collections/{{collectionId}}/items
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("list items returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("the created item is in the collection listing", function() {
    const ids = res.body.data ? res.body.data.map((i) => i.id) : res.body.map((i) => i.id);
    expect(ids).to.include(bru.getVar("itemId"));
  });
}
